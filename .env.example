# Copiez ce fichier en ".env" et adaptez les valeurs.

# Base de données PostgreSQL : postgres://utilisateur:motdepasse@serveur:port/base
# (les identifiants ci-dessous correspondent au fichier docker-compose.yml)
# Chez un hébergeur de base de données qui impose le chiffrement, ajoutez ?sslmode=require
DATABASE_URL=postgres://diop:diop@127.0.0.1:5432/diopmotors

# Numéro WhatsApp qui reçoit les commandes (format international, sans + ni espaces)
WHATSAPP_NUMBER=221770000000

# Mot de passe de l'espace admin (http://127.0.0.1:3000/admin)
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long

# Indicatif ajouté aux numéros saisis sans indicatif
DEFAULT_COUNTRY_CODE=221

# Devise affichée sur le site
CURRENCY=FCFA

# Pour tester depuis un téléphone sur le même Wi-Fi, décommentez :
# HOST=0.0.0.0

# Port du site
# PORT=3000

# En ligne, derrière HTTPS et Nginx ou Cloudflare, décommentez :
# HTTPS=1
# TRUST_PROXY=1
