{
  "name": "diopmotors",
  "version": "1.0.0",
  "description": "Diop Motors : boutique (commande WhatsApp) et annonces de deux-roues",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed-demo.js",
    "seed:clear": "node scripts/seed-demo.js --clear",
    "test": "node --test \"test/*.test.js\"",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i src/styles/tailwind.css -o public/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
